   "source": [
    "Practice Example: You have a list of sequence identifiers\n",
    "    samples = [\"sample_01\", \"control_02\", \"sample_03\", \"control_04\", \"sample_05\"]\n",
    "Complete the following tasks:\n",
    "    1. Use a list comprehension to filter out only the entries that start with \"sample_\". \n",
    "    2. Convert those filtered strings to upper case using .upper(). \n",
    "    3. Create a dictionary that pairs each formatted sample name with an initial quality score of 99."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "a4400e11-8624-47d2-be79-6c0c77ba6ded",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Filtered: ['SAMPLE_01', 'SAMPLE_03', 'SAMPLE_05']\n",
      "Dictionary: {'SAMPLE_01': 99, 'SAMPLE_03': 99, 'SAMPLE_05': 99}\n"
     ]
    }
   ],
   "source": [
    "# Task \n",
    "samples = [\"sample_01\", \"control_02\", \"sample_03\", \"control_04\", \"sample_05\"]\n",
    "filtered_samples = [s.upper() for s in samples if s.startswith(\"sample_\")]\n",
    "# Now dictionary comprehension trick\n",
    "# {key: value for item in list}\n",
    "scores = {name: 99 for name in filtered_samples}\n",
    "\n",
    "print(\"Filtered:\", filtered_samples)\n",
    "print(\"Dictionary:\", scores)\n"
   ]
  },
